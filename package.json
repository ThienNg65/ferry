{
  "name": "ferry",
  "version": "0.24.0",
  "description": "Ferry — a lightweight SFTP client with live remote log tailing",
  "main": "out/sidecar/index.cjs",
  "license": "MIT",
  "author": "ThienNg65",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThienNg65/ferry.git"
  },
  "scripts": {
    "dev": "node scripts/dev-neutralino.mjs",
    "build:sidecar": "vite build --config vite.sidecar.config.mts",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "build": "npm run build:renderer && npm run build:sidecar",
    "build:neutralino": "npm run build",
    "package": "npm run build && node scripts/pack-neutralino.mjs",
    "package:neutralino": "npm run package",
    "smoke:neutralino": "node scripts/smoke-neutralino-package.mjs",
    "e2e:migration": "node scripts/e2e-electron-migration.mjs",
    "typecheck": "vue-tsc --build --noEmit && tsc --build tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@neutralinojs/lib": "^5.6.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "archiver": "^8.0.0",
    "codemirror": "^6.0.2",
    "conf": "^10.2.0",
    "socks": "^2.8.9",
    "ssh2": "^1.16.0",
    "vue-codemirror": "^6.1.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify/vue": "^5.0.1",
    "@neutralinojs/neu": "^11.8.0",
    "@nuxt/ui": "^4.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/vue-virtual": "^3.10.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "pinia": "^2.1.7",
    "resedit": "^2.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  }
}
